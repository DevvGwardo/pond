# Delegates the pond.slice cgroup v2 subtree to the container (uid 1000) so the
# pond control plane can enforce per-capsule cpu/memory/pids limits. Required
# only for the docker-compose path on a host using Docker's systemd cgroup
# driver (see deploy/pond-cgroup-delegate.sh + deploy/HARDENING.md §2).
#
# Install:
#   cp deploy/pond-cgroup-delegate.sh /usr/local/sbin/
#   chmod +x /usr/local/sbin/pond-cgroup-delegate.sh
#   cp deploy/pond-cgroup-delegate.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now pond-cgroup-delegate.service
[Unit]
Description=Delegate pond.slice cgroup v2 subtree to the pond container (uid 1000)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/pond-cgroup-delegate.sh

[Install]
WantedBy=multi-user.target
