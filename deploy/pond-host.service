# Systemd unit for running `pond host` directly on a VM (no Docker).
#
# Install:
#   1. Copy this file to /etc/systemd/system/pond-host.service
#   2. Adjust User, WorkingDirectory, and the Environment= lines below
#   3. systemctl daemon-reload
#   4. systemctl enable --now pond-host
#
# Run logs:
#   journalctl -u pond-host -f

[Unit]
Description=Pond hosted control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pond
Group=pond
WorkingDirectory=/srv/pond
ExecStart=/usr/bin/node /srv/pond/src/cli.js host \
  --port 8787 \
  --host 127.0.0.1 \
  --data-dir /var/lib/pond \
  --public-host pond.example.com \
  --public-base-url https://pond.example.com \
  --abuse-email abuse@example.com \
  --trust-proxy

# Bind only to loopback. A reverse proxy (Cloudflare Tunnel, Caddy)
# terminates TLS and forwards.
Environment=NODE_ENV=production
Environment=POND_TRUST_PROXY_HEADERS=1
# Read POND_HOST_TOKEN from a secrets file (chmod 600 root:pond):
EnvironmentFile=-/etc/pond/host-token

Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# Hardening — these don't block the deploy-worker forks but reduce blast
# radius if something exploits the control plane itself.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pond
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# ── Per-capsule cgroup isolation (optional) ─────────────────────────────────
# To give every capsule its own cpu/memory/pids cgroup on the bare-VM path,
# uncomment the three lines below. Delegate= hands this service a writable
# cgroup subtree it can carve per-capsule children out of; it also requires
# relaxing ProtectControlGroups above to read-write — change the line to:
#   ProtectControlGroups=false
# Then point pond-host at its own delegated cgroup. Confirm the exact path with
#   systemctl show -p ControlGroup pond-host.service
# (it is normally /sys/fs/cgroup/system.slice/pond-host.service).
#
# Delegate=cpu memory pids
# Environment=POND_CAPSULE_CGROUP_ROOT=/sys/fs/cgroup/system.slice/pond-host.service
#
# The Docker path is simpler — see deploy/docker-compose.yml + README. Either
# way the host prints "capsule isolation: cgroup v2 enabled" once it works.

[Install]
WantedBy=multi-user.target
