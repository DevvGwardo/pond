#!/usr/sbin/nft -f
#
# Default-deny egress for pond capsules.
#
# The JS-level network block in src/host/deploy-worker.ts raises the bar but is
# leaky by its own admission: a capsule can still exfiltrate via dns.lookup()
# (the resolver query leaves the box before any TCP connect) or by shipping a
# native addon that bypasses the patched net.Socket. The only place to close
# that for real is the OS egress path — here.
#
# This ruleset drops all outbound traffic originating from the capsule cgroup
# subtree (everything under <POND_CAPSULE_CGROUP_ROOT>/capsule-*) except:
#   - replies on already-established/related connections (so inbound requests
#     proxied in from the control plane can be answered)
#   - NEW outbound connections to the pond egress proxy ONLY (loopback, on the
#     proxy port) when POND_EGRESS_PROXY_PORT is set — this is how a capsule
#     reaches approved external hosts: it must go through the allowlisting
#     proxy, which is the single sanctioned egress path.
# Notably it does NOT allow DNS, nor blanket loopback. A capsule can no longer
# open NEW loopback connections to sibling capsule ports or the in-container
# control plane (the capsule-to-capsule / capsule-to-control-plane gap) — only
# the proxy port, if configured. Blocking 53/udp+tcp shuts the DNS-exfil door;
# the egress proxy does DNS resolution on the capsule's behalf for allowlisted
# names. NOTE: capsules share the host loopback, so this is port-based, not
# per-capsule isolation — true per-tenant isolation needs network namespaces.
#
# cgroup matching: `socket cgroupv2 level N "path"` matches a packet whose
# socket's cgroup ancestor at depth N equals "path". With capsules living at
# /sys/fs/cgroup/pond/capsule-<id>, the ancestor at level 1 is "pond" — so
# `socket cgroupv2 level 1 "pond"` matches every capsule. If you point
# POND_CAPSULE_CGROUP_ROOT somewhere deeper (e.g. a systemd slice), adjust the
# level/path below to name the common ancestor of the capsule cgroups.
#
# Apply:   sudo nft -f deploy/capsule-egress.nft
# Inspect: sudo nft list table inet pond
# Persist: include this file from /etc/nftables.conf (or copy its table in).

table inet pond {
	chain capsule_egress {
		# Hook into the output path. priority 0, policy accept — we only act
		# on packets that match the capsule cgroup, leaving host traffic alone.
		type filter hook output priority 0; policy accept;

		# Everything below applies ONLY to packets from a capsule cgroup.
		# Non-capsule (control plane, system) traffic falls through untouched.
		socket cgroupv2 level 1 "pond" jump capsule_filter

		# Belt-and-suspenders: anonymous workers are also dropped to a dedicated
		# unprivileged uid (POND_SANDBOX_UID / the 'pond-sandbox' user) so a
		# native-addon escape lands as a powerless user. If that uid differs from
		# the control plane's, an owner-match drop stays consistent with the
		# privilege drop even if a worker ever ends up OUTSIDE the capsule cgroup
		# (e.g. cgroup delegation failed). Uncomment and set <SANDBOX_UID> to the
		# uid the host logs ("anonymous workers drop to uid=…"). The cgroup match
		# above is uid-independent and remains the primary boundary.
		#
		# meta skuid <SANDBOX_UID> jump capsule_filter
	}

	chain capsule_filter {
		# Allow replies on connections that were opened from outside (the
		# control-plane proxy forwarding a request in). New outbound flows from
		# the capsule are not "established" and fall through below.
		ct state established,related accept

		# The ONLY sanctioned new-outbound path: loopback to the pond egress
		# proxy, which enforces the per-deploy allowlist and does DNS itself.
		# Replace 8788 with your POND_EGRESS_PROXY_PORT. If you do not run the
		# egress proxy, delete this line — capsules then have zero egress.
		oifname "lo" tcp dport 8788 accept

		# Everything else a capsule tries to send outbound — direct TCP connects,
		# raw UDP, DNS queries, and NEW loopback to sibling capsules / the control
		# plane — is dropped. Use `reject` instead of `drop` if you'd rather
		# capsules fail fast than hang.
		counter drop
	}
}
