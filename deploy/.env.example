# Pond host configuration. Copy to deploy/.env and edit.

# Your bare domain. The control plane will serve the landing page here.
# Wildcard *.POND_PUBLIC_HOST must resolve to your Cloudflare Tunnel.
POND_PUBLIC_HOST=pond.example.com

# Full external base URL incl. scheme. Deploy responses link here.
POND_PUBLIC_BASE_URL=https://pond.example.com

# Contact email shown on /abuse and in /.well-known/security.txt.
POND_ABUSE_EMAIL=abuse@example.com

# Host token. Bootstrap secret used to create the first admin user and to
# recover ownership if your credentials are lost. Generate with:
#   openssl rand -hex 32
# Keep this in a password manager — anyone with it can impersonate any user.
POND_HOST_TOKEN=replace-me-with-openssl-rand-hex-32

# Trust X-Forwarded-For headers from the reverse proxy (Cloudflare Tunnel
# sets them). Required for the per-IP anonymous rate limit to work.
POND_TRUST_PROXY_HEADERS=1

# Anonymous deploy lifecycle (defaults are conservative).
POND_ANONYMOUS_CLEANUP_GRACE=1h
POND_ANONYMOUS_CLEANUP_RETENTION=7d

# Admission control: hard ceiling on concurrently-running capsules. Each live
# deploy is a resident Node process, so total RSS scales with this number; once
# the container mem_limit (docker-compose.yml, 1536m by default) is exceeded the
# kernel OOM killer can take the whole host down. A NEW deploy past this ceiling
# gets HTTP 503 (existing capsules keep running). 0 = unlimited (unsafe under a
# traffic spike). Rule of thumb: (mem_limit - ~512MB control plane) / ~150MB per
# capsule. For the default ~1.5g container (2 GB VM) that's ~6; scale linearly
# with mem_limit on a bigger box. Verify real RSS under load and tune.
POND_MAX_ACTIVE_CAPSULES=6

# Per-anonymous-deploy daily quotas (Lakebed-style). Every proxied request to an
# anonymous capsule counts toward POND_ANON_REQUESTS_PER_DAY; POST /api/mutation/*
# also counts toward POND_ANON_MUTATIONS_PER_DAY. Over the cap the control plane
# returns 429 until the next UTC day, WITHOUT waking the capsule — so one hammered
# anonymous app can't monopolize CPU/IO even within its concurrency slot. Claiming
# a deploy lifts both caps. 0 = unlimited.
POND_ANON_REQUESTS_PER_DAY=10000
POND_ANON_MUTATIONS_PER_DAY=1000

# Per-capsule cgroup v2 isolation. When set to a delegated cgroup v2 subtree,
# every capsule runs in its own child cgroup with cpu/memory/pids limits so one
# deploy can't starve the others. Run deploy/setup-capsule-isolation.sh first.
# The /sys/fs/cgroup mount in docker-compose.yml is required for this.
# Leave unset to disable (capsules then rely only on the V8 heap cap).
# POND_CAPSULE_CGROUP_ROOT=/sys/fs/cgroup/pond

# Uniform capsule egress policy (applies to ALL capsules regardless of claim
# status). See deploy/HARDENING.md for the rollout.
#   open   - legacy: only anonymous-unclaimed capsules are network-restricted;
#            claimed capsules keep full outbound network (current default).
#   sealed - NO capsule may make outbound connections (uniform isolation; will
#            break apps that call external APIs).
#   proxy  - capsules reach only their per-deploy allowlist via the egress proxy
#            (staged — not yet wired end-to-end; see deploy/HARDENING.md).
# POND_CAPSULE_EGRESS=open
# NOTE: deploy/capsule-egress.nft hard-codes the proxy port (8788). If you change
# POND_EGRESS_PROXY_PORT, edit the matching `tcp dport` line in that .nft file too.
# POND_EGRESS_PROXY_PORT=8788
